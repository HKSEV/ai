# 필요 시 이 예시 파일을 변경하여 사용하세요

PORT=8000
APP_ENV=production

# DATABASE_URL 설정 시 아래 DB_*보다 우선합니다. 비밀번호의 특수문자는 URL 인코딩하세요.
DATABASE_URL=
FRONTEND_URL=http://heartbreakkid.co.kr/group/one/3

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_LOCAL_REST_API_KEY=
KAKAO_MOBILITY_REST_API_KEY=
# 데이터 저장/재이용 조건을 확인한 경우에만 true로 설정합니다.
KAKAO_PLACE_STORAGE_ALLOWED=true

GEMINI_API_KEY=
# 해당 API 키에서 사용 가능한 structured output 지원 모델 ID
GEMINI_MODEL=
#GEMINI_SEARCH_ENABLED=true

SESSION_DAYS=14
# HTTPS 운영 환경에서는 반드시 true
COOKIE_SECURE=false
INCLUDE_DEMO_DATA=false
DATA_MAX_AGE_DAYS=30
# UPLOADS_DIR 미설정 시 backend/uploads
