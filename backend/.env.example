APP_ENV=development
# DATABASE_URL 설정 시 아래 DB_*보다 우선합니다. 비밀번호의 특수문자는 URL 인코딩하세요.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nowon_food
DB_USER=nowon
DB_PASSWORD=replace-with-your-database-password
FRONTEND_URL=http://localhost:3000

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
KAKAO_LOCAL_REST_API_KEY=
# 데이터 저장/재이용 조건을 확인한 경우에만 true로 설정합니다.
KAKAO_PLACE_STORAGE_ALLOWED=false

GEMINI_API_KEY=
# 해당 API 키에서 사용 가능한 structured output 지원 모델 ID
GEMINI_MODEL=gemini-3.8-flash

SESSION_DAYS=14
# HTTPS 운영 환경에서는 반드시 true
COOKIE_SECURE=false
INCLUDE_DEMO_DATA=false
DATA_MAX_AGE_DAYS=30
# UPLOADS_DIR 미설정 시 backend/uploads
