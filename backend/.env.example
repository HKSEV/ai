# 로컬 개발 시 이 파일을 .env로 복사한 뒤 값을 설정하세요.

PORT=8000
APP_ENV=development

# DATABASE_URL을 설정하면 아래 DB_*보다 우선합니다. SQLite 예시는 sqlite:///./nowon.db입니다.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nowon_food
DB_USER=nowon
DB_PASSWORD=

FRONTEND_URL=http://localhost:3000/group/one/3

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
KAKAO_LOCAL_REST_API_KEY=
KAKAO_MOBILITY_REST_API_KEY=
# 데이터 저장/재이용 조건을 확인한 경우에만 true로 설정합니다.
KAKAO_PLACE_STORAGE_ALLOWED=true

GEMINI_API_KEY=
# 해당 API 키에서 사용 가능한 structured output 지원 모델 ID
GEMINI_MODEL=

# 선택 사항. python -m scripts.sync_good_price_menus에서 사용합니다.
GOOD_PRICE_API_KEY=
# 기본값은 backend/data/good-price-menus.json입니다.
# GOOD_PRICE_MENU_FILE=/data/good-price-menus.json

SESSION_DAYS=14
# HTTPS API에서는 true로 설정하세요.
COOKIE_SECURE=false
INCLUDE_DEMO_DATA=false
DATA_MAX_AGE_DAYS=30
# UPLOADS_DIR 미설정 시 backend/uploads
